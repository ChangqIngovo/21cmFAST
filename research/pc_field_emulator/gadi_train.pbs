#!/usr/bin/env bash
#PBS -N pc_field_train
#PBS -P qp00
#PBS -q normal
#PBS -l ncpus=32
#PBS -l mem=64GB
#PBS -l walltime=02:00:00
#PBS -l jobfs=4GB
#PBS -l storage=gdata/qp00+scratch/qp00
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${RUN_DIR:?Submit with qsub -v RUN_DIR=/prepared/training/run}"
: "${PBS_JOBID:?Launch this script with qsub}"
: "${PBS_NCPUS:?Missing allocated CPU count}"
cd "$RUN_DIR"
test -f PREPARED
if [[ -f COMPLETED ]]; then echo 'Training already completed.'; exit 0; fi
if [[ -d results ]]; then
    echo 'An output directory already exists; prepare a fresh training run.' >&2
    exit 2
fi
mkdir .running || { echo 'Training is active or its lock is stale.' >&2; exit 2; }
exec > "run_${PBS_JOBID}.log" 2>&1
trap 'status=$?; rmdir "$RUN_DIR/.running" || true; if (( status != 0 )); then printf "%s\n" "$status" > "$RUN_DIR/FAILED"; fi' EXIT
printf 'Job: %s\nRun: %s\nStart: %s\n' "$PBS_JOBID" "$RUN_DIR" "$(date)"
sha256sum --quiet -c prepared.sha256
module --force purge
source "$RUN_DIR/runtime.env"
module load "${PC_MODULES[@]}"
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Four independent fits; each process may use eight BLAS threads.
export OPENBLAS_NUM_THREADS=8 OMP_NUM_THREADS=8 MKL_NUM_THREADS=8 NUMEXPR_NUM_THREADS=8
export MPLBACKEND=Agg
pc_python=$(cat "$RUN_DIR/python_path.txt")
"$pc_python" - "$RUN_DIR" <<'PY'
import hashlib
import json
import os
from pathlib import Path
import platform
import subprocess
import sys

import matplotlib
import numpy
import scipy

run = Path(sys.argv[1]).resolve()
manifest = json.loads((run / 'run_manifest.json').read_text())
if manifest.get('schema') != 2 or manifest.get('experiment') != 'pc-field-emulator':
    raise RuntimeError('Wrong training preparation manifest.')
if str(run) != manifest['run_directory']:
    raise RuntimeError('Prepared training directory moved.')
if int(os.environ['PBS_NCPUS']) != manifest['requested_cpus']:
    raise RuntimeError('This run was prepared for 32 CPUs.')
if str(Path(sys.executable).absolute()) != manifest['python']:
    raise RuntimeError('Selected Python executable changed.')
if str(Path(sys.executable).resolve()) != manifest['python_binary']:
    raise RuntimeError('Python binary moved.')
with Path(sys.executable).resolve().open('rb') as stream:
    digest = hashlib.file_digest(stream, 'sha256').hexdigest()
if digest != manifest['python_binary_sha256']:
    raise RuntimeError('Python binary changed after preparation.')
versions = {
    'python': platform.python_version(), 'numpy': numpy.__version__,
    'scipy': scipy.__version__, 'matplotlib': matplotlib.__version__,
}
if versions != manifest['versions']:
    raise RuntimeError('Training dependencies changed after preparation.')
print('Commit:', manifest['commit'], flush=True)
print('Inputs:', manifest['input_roots'], flush=True)
print('Frozen committed snapshots:', manifest['frozen_sample_count'], flush=True)
print('Workers:', manifest['trial_workers'], '; BLAS threads/worker:',
      manifest['blas_threads_per_worker'], flush=True)
subprocess.run([
    sys.executable, str(run / 'source/research/pc_field_emulator/train.py'),
    *manifest['arguments'],
], check=True, cwd=run / 'source')
PY
sha256sum --quiet -c prepared.sha256
test -f results/summary.json
touch COMPLETED
printf 'Finished: %s\nResults: %s/results\n' "$(date)" "$RUN_DIR"
