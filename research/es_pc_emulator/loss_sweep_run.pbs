#!/usr/bin/env bash
#PBS -N es_pc_loss_sweep
#PBS -l jobfs=4GB
#PBS -j oe
#PBS -l wd
set -euo pipefail
: "${PBS_JOBID:?Submit with qsub}"
: "${PBS_NCPUS:?Missing allocation}"
: "${LOSS_SWEEP_RUN:?Use loss_sweep_prepare.sh}"
cd "$LOSS_SWEEP_RUN"
exec 9>"$LOSS_SWEEP_RUN/run.lock"
flock -n 9 || { echo 'This sweep already has an active job.' >&2; exit 2; }
if [[ -e COMPLETED ]]; then
    echo "Already completed: $LOSS_SWEEP_RUN"
    exit 0
fi
exec > >(tee -a "$LOSS_SWEEP_RUN/run.log") 2>&1
trap 'status=$?; if (( status != 0 )); then printf "%s\n" "$status" > "$LOSS_SWEEP_RUN/FAILED"; fi' EXIT
module --force purge
source "$LOSS_SWEEP_RUN/runtime.env"
module load "${PC_MODULES[@]}"
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
python=$(cat "$LOSS_SWEEP_RUN/python_path.txt")
cd "$LOSS_SWEEP_RUN/source"
"$python" -m research.es_pc_emulator.loss_sweep \
    --manifest "$LOSS_SWEEP_RUN/dataset_manifest.json" \
    --output "$LOSS_SWEEP_RUN/training" \
    --config "$LOSS_SWEEP_RUN/configuration.json" \
    --threads "$PBS_NCPUS" --resume
rm -f "$LOSS_SWEEP_RUN/FAILED"
touch "$LOSS_SWEEP_RUN/COMPLETED"
printf 'Results: %s/training/sweep_report.json\n' "$LOSS_SWEEP_RUN"
printf 'Figures: %s/training/{loss_sweep,learning_curves}.png\n' "$LOSS_SWEEP_RUN"
printf 'Selected model evaluation: %s/training/selected_summary.json\n' "$LOSS_SWEEP_RUN"
