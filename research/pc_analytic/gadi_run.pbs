#!/usr/bin/env bash
#PBS -N analytic_pc
#PBS -P qp00
#PBS -q normal
#PBS -l ncpus=8
#PBS -l mem=32GB
#PBS -l walltime=04:00:00
#PBS -l jobfs=4GB
#PBS -l storage=gdata/qp00+scratch/qp00
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${PC_ANALYTIC_RUN:?Use the prepared resubmit.sh}"
: "${PBS_JOBID:?Launch with qsub}"
: "${PBS_NCPUS:?Missing CPU allocation}"
run=$(realpath "$PC_ANALYTIC_RUN")
cd "$run"
test -f PREPARED
exec 9> "$run/run.lock"
flock -n 9 || { echo 'Another process is using this run.' >&2; exit 2; }
exec > >(tee "$run/run_${PBS_JOBID}.log") 2>&1
rm -f "$run/FAILED" "$run/COMPLETED"
trap 'status=$?; if (( status != 0 )); then rm -f "$run/COMPLETED"; printf "%s\n" "$status" > "$run/FAILED"; fi' EXIT
sha256sum --quiet -c prepared.sha256
PC_MODULES=()
source "$run/runtime.env"
if (( ${#PC_MODULES[@]} )); then
    module --force purge
    module load "${PC_MODULES[@]}"
fi
unset PYTHONPATH PYTHONHOME
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MPLBACKEND=Agg
export OMP_NUM_THREADS="$PBS_NCPUS" OMP_THREAD_LIMIT="$PBS_NCPUS"
export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
pc_python=$(cat "$run/python_path.txt")
input_run=$(cat "$run/input_run.txt")
CXX=$("$pc_python" -c 'import json,sys; print(json.load(open(sys.argv[1]))["runtime"]["compilers"]["CXX"]["path"])' "$run/run_manifest.json")
SCRIPT_FC=$("$pc_python" -c 'import json,sys; print(json.load(open(sys.argv[1]))["runtime"]["compilers"]["SCRIPT_FC"]["path"])' "$run/run_manifest.json")
FFLAGS=$("$pc_python" -c 'import json,sys; print(json.load(open(sys.argv[1]))["runtime"]["c2ray_fflags"])' "$run/run_manifest.json")
export CXX SCRIPT_FC FFLAGS
export TMPDIR="${PBS_JOBFS:-$run/tmp}"
mkdir -p "$TMPDIR"
cd "$run/source"
"$pc_python" -m research.pc_analytic.prepare verify --run "$run" --cpus "$PBS_NCPUS"
export PYTHONPATH="$input_run/native_build/source/src"
printf 'Job: %s\nRun: %s\nInput: %s\nStart: %s\n' "$PBS_JOBID" "$run" "$input_run" "$(date)"
"$pc_python" -m research.pc_analytic.compare --config "$run/experiment_config.json" --output "$run/results"
"$pc_python" -m research.pc_analytic.prepare verify --run "$run" --cpus "$PBS_NCPUS"
test -f "$run/results/COMPLETED"
printf 'Analytic PC, original SCRIPT and C2-Ray comparison completed; inspect diagnostics.\n' > "$run/COMPLETED"
printf 'Finished: %s\nResults: %s/results\n' "$(date)" "$run"
